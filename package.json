{
  "name": "aisidequest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "npm run build:server && npm run start:server",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "node --enable-source-maps server/dist/main.js",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run build:server && typeorm migration:run -d server/dist/database/data-source.js",
    "db:revert": "npm run build:server && typeorm migration:revert -d server/dist/database/data-source.js",
    "db:show": "npm run build:server && typeorm migration:show -d server/dist/database/data-source.js",
    "db:seed": "npm run build:server && node --enable-source-maps server/dist/database/seeds/development-quests.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "typecheck": "npm run typecheck:client && npm run typecheck:server",
    "typecheck:client": "tsc -b --pretty false",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit --pretty false",
    "test": "npm run test:client && npm run test:plugin && npm run test:server",
    "test:client": "vitest run",
    "test:plugin": "node --test plugins/aisidequest/tests/*.test.mjs",
    "test:hooks": "npm run test:plugin",
    "test:server": "tsc -p server/tsconfig.test.json && node --test server/dist-test/test/app.e2e.test.js server/dist-test/test/sessions/session-recovery.unit.test.js server/dist-test/test/quests/quest-attempt.unit.test.js",
    "test:database": "tsc -p server/tsconfig.test.json && node --test --test-concurrency=1 server/dist-test/test/database/database.integration.test.js server/dist-test/test/auth/auth.integration.test.js server/dist-test/test/devices/device.integration.test.js server/dist-test/test/sessions/session.integration.test.js server/dist-test/test/quests/quest.integration.test.js server/dist-test/test/quests/quest-attempt.integration.test.js",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/typeorm": "^11.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "lucide-react": "^1.24.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
