{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/scripts/record-event.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"node (Join-Path $env:PLUGIN_ROOT 'scripts\\record-event.mjs')\"",
            "timeout": 5
          }
        ]
      }
    ],
