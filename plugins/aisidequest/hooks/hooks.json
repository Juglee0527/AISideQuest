{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AISIDEQUEST_HOST_PID=$PPID node \"$PLUGIN_ROOT/scripts/record-event.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command \"$parentProcess = Get-CimInstance Win32_Process -Filter ('ProcessId=' + $PID); $env:AISIDEQUEST_HOST_PID = [string]$parentProcess.ParentProcessId; node (Join-Path $env:PLUGIN_ROOT 'scripts\\record-event.mjs')\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AISIDEQUEST_HOST_PID=$PPID node \"$PLUGIN_ROOT/scripts/record-event.mjs\"",
