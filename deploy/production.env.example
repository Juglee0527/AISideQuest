NODE_ENV=production
DEPLOYMENT_ENVIRONMENT=production
SERVICE_VERSION=git-REPLACE_WITH_COMMIT_SHA
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGIN=https://aisidequest.example
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PRODUCTION_DB:5432/aisidequest
DATABASE_SSL=true
GITHUB_CLIENT_ID=REPLACE_PRODUCTION_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=REPLACE_PRODUCTION_GITHUB_CLIENT_SECRET
GITHUB_CALLBACK_URL=https://aisidequest.example/api/v1/auth/github/callback
# Optional; leave all three empty to keep the GitHub Discover source disabled.
GITHUB_DISCOVER_TOKEN=
GITHUB_DISCOVER_ORGANIZATIONS=
GITHUB_DISCOVER_REPOSITORIES=
AUTH_SUCCESS_REDIRECT_URL=https://aisidequest.example/
AUTH_FAILURE_REDIRECT_URL=https://aisidequest.example/?authError=github_oauth_failed
AUTH_SESSION_TTL_HOURS=168
OPERATIONAL_LOG_ENABLED=true
METRICS_BEARER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TRUST_PROXY_HOPS=1
INTEGRATION_EVENTS_ENABLED=true
QUEST_REWARDS_ENABLED=true
SITE_ADDRESS=aisidequest.example
AISIDEQUEST_API_IMAGE=ghcr.io/REPLACE_OWNER/aisidequest/api@sha256:REPLACE_DIGEST
AISIDEQUEST_WEB_IMAGE=ghcr.io/REPLACE_OWNER/aisidequest/web@sha256:REPLACE_DIGEST
