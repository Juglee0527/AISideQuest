NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=staging
SERVICE_VERSION=rehearsal
API_HOST=0.0.0.0
API_PORT=3000
CORS_ORIGIN=http://127.0.0.1:18080
DATABASE_URL=postgresql://aisidequest:rehearsal-only@postgres:5432/aisidequest
DATABASE_SSL=false
GITHUB_CLIENT_ID=rehearsal-client
GITHUB_CLIENT_SECRET=rehearsal-secret
GITHUB_CALLBACK_URL=http://127.0.0.1:18080/api/v1/auth/github/callback
GITHUB_DISCOVER_TOKEN=
GITHUB_DISCOVER_ORGANIZATIONS=
GITHUB_DISCOVER_REPOSITORIES=
AUTH_SUCCESS_REDIRECT_URL=http://127.0.0.1:18080/
AUTH_FAILURE_REDIRECT_URL=http://127.0.0.1:18080/?authError=github_oauth_failed
AUTH_SESSION_TTL_HOURS=168
OPERATIONAL_LOG_ENABLED=true
METRICS_BEARER_TOKEN=rehearsal-only-metrics-token
TRUST_PROXY_HOPS=1
INTEGRATION_EVENTS_ENABLED=true
QUEST_REWARDS_ENABLED=true
